# ==============================================================================
# AI Wardrobe — Backend Environment Configuration Example
# Copy this file to .env and replace placeholder values with your actual config.
# Do NOT commit your real .env file with secrets to version control.
# ==============================================================================

# --- Database Configuration ---
# PostgreSQL connection string using the asyncpg driver (required)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_wardrobe

# --- Authentication & JWT Security ---
# Secret key used for signing JWT tokens. In production, use a strong random secret.
# You can generate one via: openssl rand -hex 32
SECRET_KEY=replace-this-with-a-secure-random-secret-key-in-production

# JWT signature algorithm (default: HS256)
ALGORITHM=HS256

# JWT token expiration time in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Google Gemini AI Stylist ---
# Google Gemini API key obtained from Google AI Studio (required for AI recommendations)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model identifier (e.g., gemini-1.5-flash, gemini-1.5-pro, or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# --- Cloudinary Image Storage ---
# Required for uploading, hosting, and serving wardrobe clothing item photos
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --- CORS & Security Configuration ---
# Comma-separated list of allowed frontend origins (e.g., https://your-app.vercel.app,http://localhost:5173)
# Use "*" for open access during local development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5502

# --- Server Deployment (Render / Local) ---
# Environment mode: 'development' enables hot-reload; 'production' optimizes for performance
ENVIRONMENT=development

# Host interface to bind (default: 0.0.0.0 for containerized deployment)
HOST=0.0.0.0

# Port to listen on (Render automatically supplies $PORT in production; default: 8000)
PORT=8000
